{
  "info": {
    "name": "FreightFox Toll Plaza Service API",
    "description": "Postman Collection for FreightFox Backend Assignment - Toll Plaza Discovery Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Find Toll Plazas (Bengaluru to Pune)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sourcePincode\": \"560064\",\n  \"destinationPincode\": \"411045\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/toll-plazas",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "v1", "toll-plazas"]
        }
      }
    },
    {
