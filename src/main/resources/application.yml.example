# Example configuration file for FreightFox Toll Plaza Service
# Copy to application.yml or set corresponding environment variables in production.

server:
  port: 8080

spring:
  application:
    name: tollplaza-service

  datasource:
    url: jdbc:postgresql://localhost:5432/tollplaza_db
    username: your_postgres_user
    password: your_postgres_password
    driver-class-name: org.postgresql.Driver

  jpa:
    open-in-view: false
    hibernate:
      ddl-auto: update
    show-sql: false

  cache:
    type: caffeine
    caffeine:
      spec: maximumSize=500,expireAfterWrite=60m

app:
  toll-data:
    csv-path: src/main/resources/data/toll_plaza_india.csv
    auto-import-on-startup: true
  geospatial:
    corridor-threshold-meters: 500.0
  routing:
    provider: osrm
    osrm:
      base-url: https://router.project-osrm.org
      timeout-seconds: 10
    mappls:
      client-id: YOUR_MAPPLS_CLIENT_ID
      client-secret: YOUR_MAPPLS_CLIENT_SECRET
  geocoding:
    provider: nominatim
    nominatim:
      base-url: https://nominatim.openstreetmap.org
      user-agent: "FreightFox-TollPlazaService/1.0"
      timeout-seconds: 5

